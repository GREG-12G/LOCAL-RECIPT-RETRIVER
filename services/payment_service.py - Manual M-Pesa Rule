from database.connection import get_connection

def record_payment(order_id, method, amount_cents, mpesa_ref=None, confirmed_by=None):
    conn = get_connection()
    try:
        # SECURITY: Check amount matches order total
        order = conn.execute("SELECT total_cents FROM orders WHERE id=?", (order_id,)).fetchone()
        if not order:
            return False, "Order not found"
        if order['total_cents'] != amount_cents:
            return False, f"Amount mismatch. Expected {order['total_cents']}"

        # SECURITY: Prevent duplicate M-Pesa ref
        if mpesa_ref:
            exists = conn.execute("SELECT id FROM payments WHERE mpesa_ref=?", (mpesa_ref,)).fetchone()
            if exists:
                return False, "Duplicate M-Pesa reference already used"

        conn.execute(
            "INSERT INTO payments (order_id, method, amount_cents, mpesa_ref, status, confirmed_by) VALUES (?,?,?,?,?,?)",
            (order_id, method, amount_cents, mpesa_ref, 'confirmed', confirmed_by)
        )
        conn.execute("UPDATE orders SET status='paid' WHERE id=?", (order_id,))
        conn.execute("INSERT INTO audit_logs (user_id, action, details) VALUES (?,?,?)",
                     (confirmed_by, "PAYMENT_CONFIRMED", f"Order {order_id} {method} {mpesa_ref}"))
        conn.commit()
        return True, "Payment confirmed"
    except Exception as e:
        conn.rollback()
        return False, str(e)
    finally:
        conn.close()
